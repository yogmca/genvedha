# GenVedha Website Configuration
# ========================================================================

# MongoDB Configuration
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_CLUSTER=your_cluster.mongodb.net
MONGODB_DATABASE=genvedha_contacts

# Server Configuration
# ========================================================================
PORT=3000

# GenVedha LLM Service Configuration
# ========================================================================
# Claude API Key for AI-powered app generation
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# GenVedha Service Settings
GENVEDHA_SERVICE_PORT=3001
ENABLE_GENVEDHA_SERVICE=true
GENVEDHA_API_KEY=your_genvedha_api_key_here

# Genvedha Guru - App Creation Feature Flag
# Set to true to enable the "Start Creating" flow on the Genvedha Guru page.
# When false (default), the "Start Creating" button is disabled for public visitors.
ENABLE_GENVEDHA_CREATION=false

# Online/Offline Mode Configuration for Genvedha Guru
# Set REACT_APP_USE_CLAUDE_API=true to enable AI-powered mode (requires API key on server)
# Set REACT_APP_USE_CLAUDE_API=false to use offline rule-based mode
REACT_APP_USE_CLAUDE_API=false

# LLM Model Configuration for Genvedha Guru
# Options: claude, nvidia
REACT_APP_LLM_MODEL=claude

# API Availability Flags for Genvedha Guru
REACT_APP_CLAUDE_API_AVAILABLE=true
REACT_APP_NVIDIA_API_AVAILABLE=false

# NVIDIA API Configuration (for app generation)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=0.7

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=GenVedha <your_email@gmail.com>
EMAIL_TO=support@genvedha.com
